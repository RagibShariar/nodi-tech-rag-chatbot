# Copy to .env and adjust. All values below are the defaults used when .env is missing.

# Ollama server (runs the embedding model, later the LLM)
OLLAMA_URL=http://localhost:11434

# Embedding model: bge-m3 | nomic-embed-text | qwen3-embedding:0.6b
EMBED_MODEL=bge-m3

# Qdrant local mode: folder where vectors are stored (relative to project root)
QDRANT_PATH=artifacts/qdrant

# Optional: use a Qdrant server instead of local mode
# QDRANT_URL=http://localhost:6333
