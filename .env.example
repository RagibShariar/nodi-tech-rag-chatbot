# Copy to .env and adjust. All values below are the defaults used when .env is missing.

# Ollama server (runs the embedding model, later the LLM)
OLLAMA_URL=http://localhost:11434

# Embedding model: bge-m3 | nomic-embed-text | qwen3-embedding:0.6b
EMBED_MODEL=bge-m3

# Qdrant local mode: folder where vectors are stored (relative to project root)
QDRANT_PATH=artifacts/qdrant

# Optional: use a Qdrant server instead of local mode
# QDRANT_URL=http://localhost:6333

# Reranker (Hugging Face model, runs on CPU via sentence-transformers)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# How many results vector search and BM25 each return before fusion
SEARCH_DEPTH=20
# How many fused (vector + BM25) results the reranker re-scores (the slow step: ~1.5s each on CPU)
CANDIDATES=5
# Reciprocal Rank Fusion constant
RRF_K=60
# Default retrieval mode: vector | bm25 | hybrid | rerank
RETRIEVAL_MODE=rerank
